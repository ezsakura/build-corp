# Database and application credentials. Use only URL-safe characters for DB_PASSWORD.
POSTGRES_DB=buildcorp
POSTGRES_USER=buildcorp
DB_PASSWORD=replace_with_long_url_safe_random_password
JWT_SECRET=replace_with_64_hex_char_random_secret
ADMIN_USERNAME=brigadir
ADMIN_PASSWORD=replace_with_long_random_password
IMAGE_REPOSITORY=ghcr.io/ezsakura/build-corp

# Local access stays on localhost:3000 and localhost:3001.
CLIENT_PORT=3000
ADMIN_PORT=3001
COOKIE_SECURE=false

# Set real DNS names before using the production profile on a VPS.
SITE_DOMAIN=chuvashstroy.ru
ADMIN_DOMAIN=admin.chuvashstroy.ru
